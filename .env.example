APP_NAME=QuoteFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quoteflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Transactional email provider used to register and verify customers' sending domains.
# See docs/email-domain-verification.md. Never commit real tokens.
QUOTE_FLOW_EMAIL_PROVIDER=postmark
# Postmark Account API token (Account > API Tokens), required for the Domains API.
POSTMARK_ACCOUNT_TOKEN=
# Postmark Server API token (Server > API Tokens), required to send email.
POSTMARK_SERVER_TOKEN=

# Inbound replies: customers reply to reply+<token>@QUOTE_FLOW_INBOUND_REPLY_DOMAIN.
QUOTE_FLOW_INBOUND_REPLY_DOMAIN=inbound.quoteflow.ai
# Basic auth credentials embedded in the Postmark inbound webhook URL. Use a long random secret.
POSTMARK_INBOUND_WEBHOOK_USERNAME=postmark
POSTMARK_INBOUND_WEBHOOK_SECRET=

# AI models, tried in this order: when one is rate-limited or down, the next one answers.
# Only models with a key (Ollama: a URL) are used. Free keys: aistudio.google.com (Gemini),
# console.groq.com (Groq), openrouter.ai (models ending in ":free"). Check them: php artisan ai:models --test
AI_MODEL_CHAIN=gemini,groq,openrouter,ollama,openai
GEMINI_API_KEY=            # several keys? separate them with commas; or add them in Admin → AI Models
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-4.1-mini

# AI chat log: every AI assistant chat is saved; at this size the file is emailed here and a new one starts.
AI_CHAT_LOG_EMAIL=
AI_CHAT_LOG_MAX_MB=5

# WhatsApp photos, voice notes and documents are saved privately and deleted after this many days.
# One-click WhatsApp connect (Meta Embedded Signup) through QuoteFlow's own Meta app. See docs/whatsapp-one-click-connect.md.
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_MEDIA_MAX_MB=25
WHATSAPP_MEDIA_KEEP_DAYS=180
# Voice notes are transcribed (Gemini, then Groq Whisper, then OpenAI Whisper) so the AI assistant can answer them.
WHATSAPP_TRANSCRIBE_VOICE_NOTES=true

# AI sorting of customer replies (analysis only; never sends or changes anything).
QUOTE_FLOW_AI_PROVIDER=chain
QUOTE_FLOW_AI_CLASSIFICATION_ENABLED=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Follow-ups (Task 8). Times are stored in UTC and shown in each organization's timezone.
FOLLOW_UPS_DEFAULT_TIMEZONE=America/Chicago
FOLLOW_UPS_MAX_EMAILS_PER_HOUR=10
FOLLOW_UPS_MAX_EMAILS_PER_DAY=50
FOLLOW_UPS_MIN_INTERVAL_HOURS=24

# Dashboard (Task 9): "New Customer Replies" window, in hours.
DASHBOARD_NEW_REPLIES_HOURS=24

# Billing: "stripe" for real payments, "manual" (default) keeps subscriptions locally.
BILLING_PROVIDER=manual
BILLING_TRIAL_DAYS=14
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
BILLING_SIGNUP_TRIAL_PLAN=starter
BILLING_TRIAL_REMINDER_DAYS=3
# Plan limits are enforced when things are created; set false only to roll out gradually.
BILLING_ENFORCE_LIMITS=true

# Super Admin panel (/admin) — see docs/admin-deployment.md
ADMIN_PANEL_BRAND="QuoteFlow AI"
# Log channel for refused admin access (empty = default channel)
ADMIN_AUDIT_LOG_CHANNEL=
# Audit events older than this are removed by the daily platform-audit:prune (minimum 30)
ADMIN_AUDIT_RETENTION_DAYS=730
# Admin billing and usage views
BILLING_STALE_AFTER_MINUTES=180
BILLING_USAGE_WARNING_PERCENT=80

# Where "Contact support" links go (leave empty to hide them)
SUPPORT_EMAIL=
