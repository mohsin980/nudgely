APP_NAME=QuoteFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=quoteflow
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Transactional email provider used to register and verify customers' sending domains.
# See docs/email-domain-verification.md. Never commit real tokens.
QUOTE_FLOW_EMAIL_PROVIDER=postmark
# Postmark Account API token (Account > API Tokens), required for the Domains API.
POSTMARK_ACCOUNT_TOKEN=
# Postmark Server API token (Server > API Tokens), required to send email.
POSTMARK_SERVER_TOKEN=

# Inbound replies: customers reply to reply+<token>@QUOTE_FLOW_INBOUND_REPLY_DOMAIN.
QUOTE_FLOW_INBOUND_REPLY_DOMAIN=inbound.quoteflow.ai
# Basic auth credentials embedded in the Postmark inbound webhook URL. Use a long random secret.
POSTMARK_INBOUND_WEBHOOK_USERNAME=postmark
POSTMARK_INBOUND_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
